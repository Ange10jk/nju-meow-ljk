page {
    display: flex;
    flex-direction: column;
  }
    /*加载中提示*/
  .tip_text {
    width: 100%;
    height: 100%;
    line-height: 900rpx;
    text-align: center;
    color: rgba(0, 0, 0, 0.5);
    font-size: 28rpx;
  }
  /* 头部搜索区域 */
  .header {
    display: flex;
    align-items: center;
    padding: 20rpx 30rpx;
    background-color: #fff;
    border-bottom: 1rpx solid #eaeaea;
    box-shadow: 0 2rpx 5rpx rgba(0, 0, 0, 0.05);
    position:fixed;
    width:100%;
    overflow:hidden;
    z-index:3;
  }
  
  .header-avatar {
    width: 70rpx;
    height: 70rpx;
    border-radius: 50%;
  }
  
  .search {
    font-size: 28rpx;
    margin-left: 30rpx;
    color: #888888;
    flex: 1;
  }
  
  /* 页面容器 */
  .container {
    display: flex;
    height:100%;
    /* height: calc(100vh - 100rpx); */
    background-color: #f5f5f5;
    margin-top:100rpx;
  }
  
  /* 左侧分类导航 */
  .category-nav {
    width: 180rpx;
    height: 100%;
    background-color: #fff;
    overflow-y: auto;
    box-shadow: 2rpx 0 5rpx rgba(0, 0, 0, 0.05);
    position:fixed;
  }
  
  .category-item {
    padding: 30rpx 0;
    text-align: center;
    font-size: 28rpx;
    color: #666;
    border-left: 6rpx solid transparent;
    position: relative;
  }
  
  .category-item.active {
    color: #94070a;
    background-color: #f8f8f8;
    border-left: 6rpx solid #94070a;
    font-weight: bold;
  }
  
  /* 右侧内容区域 */
  .content-area {
    flex: 1;
    height: 100%;
    width:100%;
    overflow-y: auto;
    padding: 20rpx;
    background-color: #f5f5f5;
    margin-left:180rpx;
    overflow: hidden;
  }
  
  /* 猫咪列表 */
  .cat-list {
    padding: 0;
    overflow-y: auto;
    background-color: #fff;
    border-radius: 10rpx;
  }
  
  .catitem {
    display: flex;
    align-items: center;
    padding: 20rpx 5rpx;
    background-color: #fff;
    margin-bottom: 0;
    box-shadow: none;
    width: 100%;
  }
  
  .avator {
    width: 100rpx;
    height: 100rpx;
    border-radius: 50%;
    margin-right: 30rpx;

  }
  
  .cat-name {
    font-size: 32rpx;
    color: #333;
    font-weight: 400;
  }
  
  .divLine {
    height: 1rpx;
    background-color: #eaeaea;
    margin: 0;
    width: 100%;
  }
  
  /* 搜索按钮样式 */
  .circle {
    position: relative;
    height: 150rpx;
    display: flex;
    align-items: center;
    padding: 0 30rpx;
    background-color: #fff;
  }