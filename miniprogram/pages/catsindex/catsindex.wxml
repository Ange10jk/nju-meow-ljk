<!--index.wxml-->
<wxs src="tool.wxs" module="tool"/>

<view class="header" >
  <image lazy-load='true' bindtap="imageTap" class='header-avatar' src="/images/icon.jpg" mode='aspectFill' ></image>
  <navigator url="/pages/search/search" bind:longpress="showUserid">
    <text class="search">点击搜索（功能暂未实现）</text>
  </navigator>
</view>

<view class="container">
  <!-- 左侧分类导航 -->
  <view class="category-nav">
    <view wx:for="{{navbar}}" 
          data-idx="{{index}}" 
          class="category-item {{currentTab==index ? 'active' : ''}}" 
          wx:key="unique" 
          bindtap="navbarTap">{{item}}
    </view>
  </view>

  <!-- 右侧内容区域 -->
  <view class="content-area" wx:if="{{ isLoading }}">
    <view class="tip_text">
      加载中...
    </view>
  </view>
  <block wx:if="{{!isLoading}}">
  <view class="content-area">
    <!-- 猫咪速览条区域 -->
    <view class="cat-list" >
      <block wx:for="{{catslist}}" wx:key="_id" wx:if="{{item.color===navbar[currentTab]}}">
        <navigator url="/pages/catdetail/catdetail?name={{item.name}}"
        bind:longpress="longpress" data-name="{{item.name}}">
          <view class="catitem">
            <image lazy-load='true' class='avator' src="https://你的CDN域名/catimageforindex/{{item.name}}.jpg" mode='aspectFill'></image>
            <view class="cat-name">{{item.name}}</view>
            <view class="status {{tool.func(item.status)}}">{{item.status}}</view>
          </view>
            <view class="divLine"></view>
        </navigator>
      </block>  
    </view>
  </view>
 </block>
</view>
<!-- </view> -->